DATABASE_URL=file:mainnet.db
# Required only for authenticated remote libSQL / Turso databases.
# DATABASE_AUTH_TOKEN=

# Optional backend-managed mainnet wallet settings. No daemon token or operator code is needed.
# BARK_POTS_DATADIR=/absolute/path/outside/the/repository
# BARKD_BIN=/absolute/path/to/barkd

# pnpm dev starts/reuses a local mainnet receiver, keeping it alive after Vite stops.
# BARK_RECEIVER_DATADIR=/absolute/path/outside/the/repository
# To use an independently managed receiver instead, set BOTH values below.
# BARK_RECEIVER_URL=http://127.0.0.1:3042
# BARK_RECEIVER_TOKEN=

# Structured logs are always enabled. Optional log-directory override:
# PAYMENTS_LOG_DIR=/absolute/path/outside/the/repository
# Optional local OTLP logs, traces, and metrics (see dev/observability/README.md):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# VITE_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=payments-server

# Docker automatically manages its Bark configuration and login in /data/runtime.env.
# Only optional deployment overrides belong in this host .env (see deploy/README.md):
# APP_PORT=3100
# APP_BIND_IP=127.0.0.1
# BARK_PAYMENTS_SOURCE_DIR=/absolute/path/to/this/repository
# PUBLIC_HOST=payments.example.com
# PUBLIC_ORIGIN=https://payments.example.com
# APP_AUTH_USERNAME=admin
# APP_AUTH_PASSWORD=<at-least-24-URL-safe-characters>
