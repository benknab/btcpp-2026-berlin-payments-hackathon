DATABASE_URL=file:local.db
# Required only for authenticated remote libSQL / Turso databases.
# DATABASE_AUTH_TOKEN=

# Optional backend-managed signet wallet settings. No daemon token or operator code is needed.
# BARK_POTS_DATADIR=/absolute/path/outside/the/repository
# BARKD_BIN=/absolute/path/to/barkd

# Always-on signet Barkd receiving wallet for event Lightning contributions.
# BARK_RECEIVER_URL=http://127.0.0.1:3032
# BARK_RECEIVER_TOKEN=
